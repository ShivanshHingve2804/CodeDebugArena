# Copy to .env and set a long random value before starting Docker Compose.
CDA_ACCESS_TOKEN=
# Set by Docker Compose. Each cloud agent supplies its own provider API key in the dashboard per run.
# Set this to your public deployment hostname when deploying behind a proxy.
CDA_ALLOWED_HOSTS=localhost,127.0.0.1
# Local browser access is loopback-only by default.
BIND_ADDRESS=127.0.0.1
PORT=8000

